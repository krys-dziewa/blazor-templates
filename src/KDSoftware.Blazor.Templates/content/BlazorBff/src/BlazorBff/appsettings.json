{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
//#if (UseOidc)
  "Authentication": {
    "Oidc": {
      // Configure your identity provider here. Store "ClientSecret" in user secrets or a secret store.
      "Authority": "",
      "ClientId": "",
      "Scopes": []
    }
  },
//#endif
  "ReverseProxy": {
    // Downstream APIs reachable by WebAssembly components through the BFF under /api.
    "Routes": {
      "downstream": {
        "ClusterId": "downstream",
//#if (UseOidc)
        "AuthorizationPolicy": "default",
//#endif
        "Match": {
          "Path": "/api/downstream/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/downstream" }
        ]
      }
    },
    "Clusters": {
      "downstream": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:7300/"
          }
        }
      }
    }
  }
}

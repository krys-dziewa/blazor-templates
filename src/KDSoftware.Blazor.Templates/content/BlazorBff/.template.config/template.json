{
  "$schema": "http://json.schemastore.org/template",
  "author": "Krystian Dziewa",
  "classifications": [ "Web", "Blazor", "WebAssembly", "BFF" ],
  "identity": "KDSoftware.Blazor.Templates.BlazorBff.CSharp",
  "groupIdentity": "KDSoftware.Blazor.Templates.BlazorBff",
  "name": "KDSoftware Blazor BFF Web App",
  "description": "A Blazor Web App where the ASP.NET Core server acts as a Backend-for-Frontend (cookie session, optional OpenID Connect, API proxy) and components choose per page between static SSR, Interactive Server and Interactive WebAssembly/Auto.",
  "shortName": "kd-blazor-bff",
  "sourceName": "BlazorBff",
  "preferNameDirectory": true,
  "defaultName": "BlazorApp",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "auth": {
      "type": "parameter",
      "datatype": "choice",
      "description": "The authentication mode of the BFF.",
      "defaultValue": "oidc",
      "choices": [
        {
          "choice": "oidc",
          "description": "OpenID Connect sign-in handled by the server with a secure cookie session. Tokens never reach the browser."
        },
        {
          "choice": "none",
          "description": "No authentication."
        }
      ]
    },
    "UseOidc": {
      "type": "computed",
      "value": "(auth == \"oidc\")"
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If specified, skips the automatic restore of the solution on create.",
      "defaultValue": "false"
    },
    "httpPort": {
      "type": "parameter",
      "datatype": "integer",
      "description": "Port number to use for the HTTP endpoint in launchSettings.json."
    },
    "httpPortGenerated": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 5000,
        "high": 5300
      }
    },
    "httpPortReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "httpPort",
        "fallbackVariableName": "httpPortGenerated"
      },
      "replaces": "5299"
    },
    "httpsPort": {
      "type": "parameter",
      "datatype": "integer",
      "description": "Port number to use for the HTTPS endpoint in launchSettings.json."
    },
    "httpsPortGenerated": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 7000,
        "high": 7300
      }
    },
    "httpsPortReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "httpsPort",
        "fallbackVariableName": "httpsPortGenerated"
      },
      "replaces": "7299"
    },
    "userSecretsId": {
      "type": "generated",
      "generator": "guid",
      "replaces": "aspnet-BlazorBff-53bc9b9d-9d6a-45d4-8429-2a2761773502",
      "parameters": {
        "defaultFormat": "d"
      }
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/[Bb]in/**",
            "**/[Oo]bj/**",
            ".template.config/**",
            "**/.vs/**",
            "**/*.user"
          ]
        },
        {
          "condition": "(!UseOidc)",
          "exclude": [
            "src/BlazorBff/Authentication/**",
            "src/BlazorBff/Components/Pages/UserClaims.razor",
            "src/BlazorBff/Components/Layout/LoginDisplay.razor",
            "src/BlazorBff.Client/Components/DownstreamApiCall.razor"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "src/BlazorBff/BlazorBff.csproj" },
    { "path": "src/BlazorBff.Client/BlazorBff.Client.csproj" }
  ],
  "postActions": [
    {
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by this solution.",
      "manualInstructions": [
        { "text": "Run 'dotnet restore'" }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}

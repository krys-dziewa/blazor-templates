@page "/weather"
@attribute [StreamRendering]
@inject IWeatherForecastService WeatherForecasts

@*
    Static SSR with streaming rendering: the page shell is sent immediately and the table is streamed
    into the same response once the data is available. No interactivity, no client runtime required.
*@

<PageTitle>Weather</PageTitle>

<h1>Weather</h1>

<p>This component demonstrates showing data with streaming rendering.</p>

@if (_forecasts is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <WeatherTable Forecasts="_forecasts" />
}

@code {
    private WeatherForecast[]? _forecasts;

    protected override async Task OnInitializedAsync()
    {
        _forecasts = await WeatherForecasts.GetForecastsAsync();
    }
}

@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <span class="me-2">@context.User.Identity?.Name</span>
        <form action="authentication/logout" method="post" class="d-inline">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="/" />
            <button type="submit" class="btn btn-link p-0 align-baseline">Log out</button>
        </form>
    </Authorized>
    <NotAuthorized>
        @* Enhanced navigation is disabled because the login endpoint redirects to the identity provider. *@
        <a href="authentication/login?returnUrl=@Uri.EscapeDataString(_returnUrl)" data-enhance-nav="false">Log in</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string _returnUrl = "/";

    protected override void OnParametersSet()
    {
        _returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
    }
}

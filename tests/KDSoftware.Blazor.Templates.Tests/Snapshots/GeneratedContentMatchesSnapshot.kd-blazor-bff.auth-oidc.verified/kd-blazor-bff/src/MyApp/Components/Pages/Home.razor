@page "/"

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

<p>
    This page is rendered with <strong>static server-side rendering</strong>: plain HTML, no WebSocket
    and no WebAssembly download. It is the fastest way to get content on screen and the default for every page.
</p>

<p>Opt in to interactivity only where a page needs it:</p>

<table class="table">
    <thead>
        <tr>
            <th>Page</th>
            <th>Render mode</th>
            <th>Use it for</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><a href="weather">Weather</a></td>
            <td>Static SSR + streaming</td>
            <td>Content pages; slow data streams in after the first paint.</td>
        </tr>
        <tr>
            <td><a href="weather/live">Live weather</a></td>
            <td>Interactive Auto</td>
            <td>SPA-like UI that should keep working in the browser and offload the server.</td>
        </tr>
        <tr>
            <td><a href="server-clock">Server clock</a></td>
            <td>Interactive Server</td>
            <td>Interactive UI that needs direct access to server resources.</td>
        </tr>
        <tr>
            <td><a href="user">User &amp; API</a></td>
            <td>Static SSR + Interactive WebAssembly (no prerendering)</td>
            <td>Calling downstream APIs through the BFF with the user's access token.</td>
        </tr>
    </tbody>
</table>

@page "/user"
@attribute [Authorize]

@*
    Static SSR protected by [Authorize]: unauthenticated users are redirected to the identity provider
    before anything renders. The claims come from the server-side cookie session.
*@

<PageTitle>User &amp; API</PageTitle>

<h1>User &amp; API</h1>

<h2 class="h4">Claims</h2>

<AuthorizeView>
    <dl class="row">
        @foreach (System.Security.Claims.Claim claim in context.User.Claims)
        {
            <dt class="col-sm-3">@claim.Type</dt>
            <dd class="col-sm-9 text-break">@claim.Value</dd>
        }
    </dl>
</AuthorizeView>

<h2 class="h4">Downstream API</h2>

<p>
    The browser calls the BFF with its session cookie; the BFF forwards the request with the user's
    access token. Tokens are never sent to the browser.
</p>

<DownstreamApiCall @rendermode="@(new InteractiveWebAssemblyRenderMode(prerender: false))" />

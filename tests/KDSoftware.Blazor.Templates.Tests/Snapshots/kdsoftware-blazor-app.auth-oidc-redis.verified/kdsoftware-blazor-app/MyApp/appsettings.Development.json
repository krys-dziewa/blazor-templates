{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Local Valkey, for example started with: podman run -d -p 6379:6379 docker.io/valkey/valkey
  "ConnectionStrings": {
    "SessionStore": "localhost:6379"
  },
  // Public Duende IdentityServer demo instance (https://demo.duendesoftware.com) so the app works out of the box.
  // These are publicly documented demo credentials, not a real secret. Replace them with your own identity provider.
  "Authentication": {
    "Oidc": {
      "Authority": "https://demo.duendesoftware.com",
      "ClientId": "interactive.confidential",
      "ClientSecret": "secret",
      "Scopes": [ "email" ]
    }
  }
}
